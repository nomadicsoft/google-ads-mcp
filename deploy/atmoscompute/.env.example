# Proposed hostname; provision DNS and TLS before using it.
GOOGLE_ADS_MCP_BASE_URL=https://google-ads-mcp.atmoscompute.com
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=
# Generate two different persistent random secrets; see README.md here.
GOOGLE_ADS_MCP_JWT_SIGNING_KEY=
GOOGLE_ADS_MCP_STORAGE_ENCRYPTION_KEY=
# Optional; set if required by your Google Ads API access configuration.
GOOGLE_ADS_DEVELOPER_TOKEN=
