# Add inside a dedicated TLS server block for the chosen MCP hostname.
# Keep AtmosCompute's existing application virtual host and OAuth routes separate.
location / {
    proxy_pass http://127.0.0.1:18080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    client_max_body_size 16m;
    # OAuth redirects contain codes; do not log query strings here.
    access_log off;
}
